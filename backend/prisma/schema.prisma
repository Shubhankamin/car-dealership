generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         String @default("USER") // "USER" | "ADMIN"
}

model Vehicle {
  id       String @id @default(uuid())
  imageUrl String?
  make     String
  model    String
  category String
  price    Float
  quantity Int    @default(0)
}